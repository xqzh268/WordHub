{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordhub.local/schema/common.schema.json",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,127}$" },
    "isoDateTime": { "type": "string", "format": "date-time" },
    "hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "ref": {
      "type": "object", "required": ["kind", "id"], "additionalProperties": false,
      "properties": { "kind": { "type": "string" }, "id": { "$ref": "#/$defs/id" }, "versionId": { "$ref": "#/$defs/id" } }
    },
    "anchor": {
      "type": "object", "required": ["sourceId", "sourceHash"], "additionalProperties": false,
      "properties": {
        "sourceId": { "$ref": "#/$defs/id" }, "sourceHash": { "$ref": "#/$defs/hash" },
        "exact": { "type": "string", "minLength": 1 }, "prefix": { "type": "string" }, "suffix": { "type": "string" },
        "chapter": { "type": "integer", "minimum": 1 }, "scene": { "type": "integer", "minimum": 1 },
        "paragraph": { "type": "integer", "minimum": 1 }, "page": { "type": "integer", "minimum": 1 },
        "start": { "type": "integer", "minimum": 0 }, "end": { "type": "integer", "minimum": 0 },
        "cfi": { "type": "string" }
      }
    },
    "actor": {
      "type": "object", "required": ["type", "id"], "additionalProperties": false,
      "properties": { "type": { "enum": ["user", "agent", "system"] }, "id": { "type": "string" }, "agentVersion": { "type": "string" } }
    },
    "status": { "type": "string", "enum": ["proposed", "accepted", "rejected", "invalidated", "reverted"] }
  }
}

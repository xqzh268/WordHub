{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wordhub.local/schema/fact.json",
  "title": "WordHub sourced atomic fact",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "projectId", "statement", "status", "assertedBy", "sourceRefs", "canon", "createdAt"],
  "properties": {
    "schemaVersion": { "const": 1 }, "id": { "$ref": "common.schema.json#/$defs/id" }, "projectId": { "$ref": "common.schema.json#/$defs/id" },
    "statement": { "type": "object", "required": ["subject", "predicate", "object"], "additionalProperties": false, "properties": { "subject": { "type": "string" }, "predicate": { "type": "string" }, "object": {} } },
    "status": { "$ref": "common.schema.json#/$defs/status" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "assertedBy": { "$ref": "common.schema.json#/$defs/actor" },
    "sourceRefs": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/anchor" } },
    "validFrom": { "$ref": "common.schema.json#/$defs/anchor" }, "validTo": { "$ref": "common.schema.json#/$defs/anchor" }, "revealedAt": { "$ref": "common.schema.json#/$defs/anchor" },
    "supersedes": { "$ref": "common.schema.json#/$defs/id" }, "scope": { "type": "string" }, "canon": { "type": "boolean" }, "branchId": { "type": "string" },
    "createdAt": { "$ref": "common.schema.json#/$defs/isoDateTime" }
  }
}
